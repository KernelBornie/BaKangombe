## B.3 — `scripts/migrate-from-json.js` (idempotent, run twice = safe)

```js
#!/usr/bin/env node
/**
 * One-shot migration: api/data.json -> Postgres via Prisma.
 * Idempotent: uses upsert by primary key.
 * Never deletes rows — safe to re-run.
 *
 * Usage:
 *   DATABASE_URL=postgresql://... node scripts/migrate-from-json.js
 */
const fs = require('fs');
const path = require('path');
const { PrismaClient, Prisma } = require('@prisma/client');
const prisma = new PrismaClient();

const DB_PATH = process.env.DB_PATH || path.join(__dirname, '..', 'api', 'data.json');

const DEC = v => new Prisma.Decimal(String(v ?? 0));
const DT = v => v ? new Date(v) : new Date();
const J = v => v ?? {};

async function migrate() {
  if (!fs.existsSync(DB_PATH)) {
    console.error(`✗ ${DB_PATH} not found. Set DB_PATH or run from repo root.`);
    process.exit(1);
  }
  const src = JSON.parse(fs.readFileSync(DB_PATH, 'utf8'));
  console.log(`→ Reading ${DB_PATH}`);
  const counts = {};

  // ---- 1. Businesses (must come first — everything FKs to it) ----
  counts.businesses = 0;
  for (const b of src.businesses || []) {
    await prisma.business.upsert({
      where: { id: b.id },
      update: {
        name: b.name,
        tpin: b.tpin ?? null,
        pacra: b.pacra ?? null,
        apiKey: b.apiKey,
        plan: b.plan ?? 'free',
        isOperator: !!b.isOperator,
        walletBalance: DEC(b.wallet?.balance ?? b.walletBalance ?? 0),
        currency: b.wallet?.currency ?? 'ZMW',
        modules: b.modules ?? [],
        subscriptionPaidAt: b.subscriptionPaidAt ? DT(b.subscriptionPaidAt) : null
      },
      create: {
        id: b.id,
        name: b.name,
        tpin: b.tpin ?? null,
        pacra: b.pacra ?? null,
        apiKey: b.apiKey,
        plan: b.plan ?? 'free',
        isOperator: !!b.isOperator,
        walletBalance: DEC(b.wallet?.balance ?? b.walletBalance ?? 0),
        currency: b.wallet?.currency ?? 'ZMW',
        modules: b.modules ?? [],
        subscriptionPaidAt: b.subscriptionPaidAt ? DT(b.subscriptionPaidAt) : null,
        createdAt: DT(b.createdAt)
      }
    });
    counts.businesses++;
  }

  // ---- 2. Ledger (audit-critical, preserve everything) ----
  counts.ledgerEntries = 0;
  for (const l of src.ledger || []) {
    await prisma.ledgerEntry.upsert({
      where: { id: l.id },
      update: {},
      create: {
        id: l.id,
        batchId: l.batchId,
        businessId: l.businessId,
        account: l.account,
        debit: DEC(l.debit),
        credit: DEC(l.credit),
        meta: J(l.meta),
        createdAt: DT(l.createdAt)
      }
    });
    counts.ledgerEntries++;
  }

  // ---- 3. Mobile money ----
  counts.mmTransactions = 0;
  for (const t of src.mmTransactions || []) {
    await prisma.mmTransaction.upsert({
      where: { id: t.id },
      update: {},
      create: {
        id: t.id,
        businessId: t.businessId,
        type: t.type,
        carrier: t.carrier,
        phone: t.phone,
        amount: DEC(t.amount),
        fee: DEC(t.fee),
        total: DEC(t.total),
        reference: t.reference,
        status: t.status ?? 'pending',
        gatewayRef: t.gatewayRef ?? null,
        simulated: !!t.simulated,
        note: t.note ?? null,
        providerRaw: t.providerRaw ?? null,
        settledAt: t.settledAt ? DT(t.settledAt) : null,
        failedAt: t.failedAt ? DT(t.failedAt) : null,
        createdAt: DT(t.createdAt)
      }
    });
    counts.mmTransactions++;
  }

  // ---- 4. Invoices ----
  counts.invoices = 0;
  for (const i of src.invoices || []) {
    await prisma.invoice.upsert({
      where: { id: i.id },
      update: {},
      create: {
        id: i.id,
        businessId: i.businessId,
        number: i.number,
        tpin: i.tpin ?? null,
        fiscalMarkId: i.fiscalMarkId ?? null,
        customer: J(i.customer),
        lines: J(i.lines),
        subtotal: DEC(i.subtotal),
        vat: DEC(i.vat),
        total: DEC(i.total),
        currency: i.currency ?? 'ZMW',
        status: i.status ?? 'unpaid',
        verifyUrl: i.verifyUrl ?? null,
