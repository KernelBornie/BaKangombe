async function reconcile() {
  // Verify: sum of wallet:cash debits - credits == business.walletBalance (within 1 cent)
  const businesses = await prisma.business.findMany({ where: { isOperator: false } });
  let mismatch = 0;
  for (const b of businesses) {
    const agg = await prisma.ledgerEntry.aggregate({
      where: { businessId: b.id, account: { in: ['wallet:cash', 'wallet:reserved'] } },
      _sum: { debit: true, credit: true }
    });
    // Ledger convention: debit subtracts, credit adds (per api/mock-db semantics)
    const fromLedger = Number(agg._sum.credit ?? 0) - Number(agg._sum.debit ?? 0);
    const fromWallet = Number(b.walletBalance);
    if (Math.abs(fromLedger - fromWallet) > 0.01) {
      console.warn(`⚠ ${b.name} (${b.id}): wallet=${fromWallet.toFixed(2)}, ledger=${fromLedger.toFixed(2)} — investigate`);
      mismatch++;
    }
  }
  if (mismatch === 0) console.log('\n✓ Ledger reconciliation: all balances match.');
  else console.log(`\n⚠ ${mismatch} business(es) have ledger/wallet mismatch. Fix before going live.`);
}

migrate()
  .then(reconcile)
  .catch(e => { console.error(e); process.exit(1); })
  .finally(() => prisma.$disconnect());
