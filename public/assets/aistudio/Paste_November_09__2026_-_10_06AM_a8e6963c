**Replace with:**

```js
app.post('/api/lending/disburse', auth, requireModule('lending'), async (req, res) => {
  const { phone, amount, termMonths = 3 } = req.body || {};
  const amt = Number(amount);
  const months = Math.max(1, Math.min(24, Number(termMonths) || 3));
  if (!phone || !Number.isFinite(amt) || amt <= 0)
    return res.status(400).json({ error: 'phone and positive amount required' });

  let elig;
  try { elig = computeEligibility({ ...req.body, requestedAmount: amt }); }
  catch (e) { return res.status(400).json({ error: e.message }); }
  if (!elig.approved) return res.status(400).json({ error: 'not approved', eligibility: elig });

  const carrier = detectCarrier(phone);
  if (!carrier) return res.status(400).json({ error: 'invalid phone' });

  // --- Disclosure math (BEFORE payout — reject if platform fee unaffordable) ---
  const originationFee  = round2(amt * 0.02);
  const interestAmount  = round2(amt * (elig.interestRatePct / 100) * (months / 12));
  const totalRepayable  = round2(amt + originationFee + interestAmount);
  const monthlyPayment  = round2(totalRepayable / months);

  // --- Pay FULL principal to borrower (never shave) ---
  const reference = `LOAN-${crypto.randomBytes(4).toString('hex').toUpperCase()}`;
  let gw;
  try {
    gw = await gateway.payout({
      carrier: carrier.code, phone: carrier.msisdn,
      amount: amt, reference, currency: 'ZMW',
      narration: `Loan disbursement ${reference}`
    });
  } catch (e) {
    return res.status(502).json({ error: 'payout failed', detail: e.message });
  }

  // --- Ledger: cash out, receivable in ---
  adjustWallet(req.biz.id, -amt);
  postLedger(req.biz.id, [
    { account: 'wallet:cash',         credit: amt, meta: { reference } },
    { account: 'asset:loans-receivable', debit: amt, meta: { reference } }
  ]);

  const loan = {
    id: id('loan'),
    businessId: req.biz.id,
    phone: carrier.msisdn,
    amount: amt,
    termMonths: months,
    originationFee,
    interestRatePct: elig.interestRatePct,
    interestAmount,
    totalRepayable,
    monthlyPayment,
    score: elig.score,
    disclosure: {
      principal: amt,
      originationFee,
      interestRatePct: elig.interestRatePct,
      termMonths: months,
      totalRepayable,
      aprEffectivePct: round2(((totalRepayable / amt) - 1) * 100 * (12 / months)),
      acceptedAt: new Date().toISOString(),
      disclosureVersion: 'v1.0'
    },
    status: 'disbursed',
    reference,
    gatewayRef: gw.providerRef,
    simulated: !!gw.simulated,
    createdAt: new Date().toISOString()
  };
  state().loans.push(loan);

  // --- Charge operator origination fee (2% of principal, NOT of repayable) ---
  billing.chargePlatformFee(req.biz.id, originationFee, 'loan', { loan: loan.id });

  save();
  res.json({ ok: true, loan });
});
```

