## B.4 — `api/db.js` (thin Prisma wrapper that keeps the same function signatures)

```js
const { PrismaClient, Prisma } = require('@prisma/client');
const prisma = new PrismaClient();

// Drop-in replacements for mock-db.js API
module.exports = {
  prisma,
  Prisma,

  async adjustWallet(businessId, delta) {
    return prisma.$transaction(async tx => {
      const b = await tx.business.findUnique({ where: { id: businessId } });
      if (!b) throw new Error('business not found');
      const next = Number(b.walletBalance) + Number(delta);
      if (next < 0) throw new Error('insufficient wallet balance');
      const updated = await tx.business.update({
        where: { id: businessId },
        data: { walletBalance: new Prisma.Decimal(next.toFixed(2)) }
      });
      return Number(updated.walletBalance);
    });
  },

  async walletBalance(businessId) {
    const b = await prisma.business.findUnique({ where: { id: businessId } });
    return b ? Number(b.walletBalance) : 0;
  },

  async postLedger(businessId, entries) {
    const batchId = 'lbr_' + require('crypto').randomBytes(6).toString('hex');
    await prisma.ledgerEntry.createMany({
      data: entries.map(e => ({
        id: 'le_' + require('crypto').randomBytes(6).toString('hex'),
        batchId, businessId,
        account: e.account,
        debit: new Prisma.Decimal(e.debit ?? 0),
        credit: new Prisma.Decimal(e.credit ?? 0),
        meta: e.meta ?? {}
      }))
    });
    return batchId;
  }
};
